# ==========================
# DrSai-Rongzai Environment
# ==========================

# Required: HepAI API key for model calls
HEPAI_API_KEY=your_hepai_api_key_here

# Optional: data workspace for Rongzai agent
WORKER_SPACE=./datasets

# Optional: worker network/runtime settings
RONGZAI_WORKER_PORT=42812
RONGZAI_WORKER_NAME=DrSai-Rongzai
RONGZAI_AGENT_INSTANCE_NAME=DrSai_Rongzai
RONGZAI_MCP_SSE_URL=http://127.0.0.1:42501/sse

# Optional: model gateway overrides
RONGZAI_HEPAI_BASE_URL=https://aiapi.ihep.ac.cn/apiv2
RONGZAI_HEPAI_ANTHROPIC_BASE_URL=https://aiapi.ihep.ac.cn/apiv2/anthropic

# Optional: logo path shown in UI / worker metadata
# RONGZAI_LOGO_PATH=./src/configs/resized_rzera_logo.png

# Optional: default remote agents catalog path for DrSai UI
# DEFAULT_REMOTE_AGENTS=./remote_agents.example.json
